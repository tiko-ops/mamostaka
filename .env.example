# Kopiera till .env.local för lokal utveckling. Checka aldrig in riktiga nycklar.
# I produktion sätts dessa i Vercel → Project → Settings → Environment Variables.

# Krävs. Används bara på servern (app/api/correct/route.ts), skickas aldrig till webbläsaren.
OPENAI_API_KEY=

# Valfri. Standard: gpt-4o-mini
OPENAI_MODEL=
